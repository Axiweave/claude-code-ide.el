                        (claude-code-ide-zmx--quote linked) " || return \"$?\"\n"
                        "}\ncci_plan\n")))
            (dolist (file '("runner.sh" "zmx")) (set-file-modes (expand-file-name file root) #o700))
            (dolist (file '("manifest" "plan.sh" "admitted-inventory" "inventory" "next-inventory"))
