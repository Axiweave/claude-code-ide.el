                (insert "cci_plan() {\n  cci_protect 1 " guard " || return \"$?\"\n"
                        "  cci_step 1 backend-merge "
                        (claude-code-ide-zmx--quote root)
                        " /bin/sh -c 'printf landed > effect; cp next-inventory inventory' || return \"$?\"\n"
                        "  cci_protect 2 " guard " || return \"$?\"\n"
