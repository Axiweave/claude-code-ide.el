                                    (cons "foreign-token" '("worktree" "move" "a" "b"))))))
    (should-error
     (claude-code-ide-remote-worktree--capture-native
      (claude-code-ide-remote-worktree--make-operation :kind 'move) thunk)
     :type 'user-error)))

