      (dolist (directory (list "relative/path" "/bad\npath" "/bad\tpath"
                               (concat "/bad" (string #x7f) "path")
                               (concat "/bad" (string #x80) "path")
                               (concat "/bad" (string #x9f) "path")
                               (concat "/" (make-string 20000 ?x))))
        (should-error
