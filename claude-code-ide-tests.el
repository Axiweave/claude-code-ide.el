             (nth 4 request)
             '(:status 127 :stdout ""
                       :stderr "startup warning\nmissing login shell\n"))
            nil)))
      (claude-code-ide-remote-worktree--prepare-launch
       operation (lambda (&rest _) (setq launched t))))
    (should (= (length requests) 1))
