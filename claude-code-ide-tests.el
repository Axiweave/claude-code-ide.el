         (key (claude-code-ide-tests--remote-view-key
               "host-a" 'git "/rpc:host-a:/repo" "/rpc:host-a:/repo/sub/"))
         (record
          (claude-code-ide-remote-project--make-view
           :key key :buffer view :origin 'created-by-feature
           :creator 'magit)))
    (with-current-buffer view
      (insert "unchanged")
