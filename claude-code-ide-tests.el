               #'ignore)
              ((symbol-function 'claude-code-ide-manager--save-state) #'ignore)
              ((symbol-function 'claude-code-ide-manager--mark-session-managed) #'ignore)
              ((symbol-function 'claude-code-ide-manager--reset-session-idle-state)
               #'ignore)
